{
  "editor.fontFamily": "'Source Code Pro'",
  "editor.fontWeight": "400",
  "tailwindCSS.includeLanguages": {
    "vue": "html"
  },
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "workbench.iconTheme": "gruvbox-material-icon-theme",
  "editor.renderWhitespace": "all",
  "workbench.experimental.modernUIEditorTabStyle": "connected",
  "workbench.experimental.modernUIUppercaseViewHeaders": false,
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Tlapalli l-00: Obsidian Light",
  "workbench.preferredDarkColorTheme": "Tlapalli 00: Obsidian",
  "editor.experimentalGpuAcceleration": "on",
  "i18n-ally.localesPaths": [
    "i18n",
    "i18n/locales"
  ]
}
