{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "partsMeta",
  "type": "object",
  "properties": {
    "order": {
      "type": "number"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "changelogs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "default": []
    },
    "links": {
      "type": "object",
      "properties": {
        "site": {
          "type": "string",
          "format": "uri"
        },
        "video": {
          "type": "string",
          "format": "uri"
        },
        "marketplace": {
          "type": "string",
          "format": "uri"
        },
        "openvsx": {
          "type": "string",
          "format": "uri"
        },
        "previewAccess": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "devlogPlaylist": {
      "type": "string"
    }
  },
  "required": [
    "order"
  ],
  "additionalProperties": false
}
