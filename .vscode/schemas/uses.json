{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "uses",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string"
              },
              "es": {
                "type": "string"
              }
            },
            "required": [
              "en",
              "es"
            ],
            "additionalProperties": false
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "since": {
                  "type": "integer"
                },
                "until": {
                  "type": "integer"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "note": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string"
                    },
                    "es": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "en",
                    "es"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slug",
          "name",
          "tools"
        ],
        "additionalProperties": false
      },
      "default": []
    }
  },
  "additionalProperties": false
}